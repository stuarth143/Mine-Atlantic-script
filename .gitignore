-- Combined Script (Main Frame Top-Center Position)
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId
local JobId = game.JobId

-- ============================================
-- ⚡ AUTOMATIC FEATURES (ALWAYS ON)
-- ============================================

-- 1. INSTANT PROXIMITY PROMPT
local function SetupProximityPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        prompt.HoldDuration = 0
    end
end

workspace.DescendantAdded:Connect(SetupProximityPrompt)
for _, prompt in ipairs(workspace:GetDescendants()) do
    SetupProximityPrompt(prompt)
end

-- 2. INFINITE JUMP & JUMP POWER
local function applyJumpSettings(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 55
    end
end

if LocalPlayer.Character then
    applyJumpSettings(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(applyJumpSettings)

UserInputService.JumpRequest:Connect(function()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- 3. INVISICAM CAMERA
LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam


-- ============================================
-- 🛒 AUTO-BUY & HOP SETTINGS
-- ============================================

local BombRemote = ReplicatedStorage:WaitForChild("BombRemotes"):WaitForChild("BuyBomb")
local RadarRemote = ReplicatedStorage:WaitForChild("RadarRemotes"):WaitForChild("BuyRadar")

local BombNames = {
    "ClassicBomb", "SnowflakeBomb", "IceBomb", "FireBomb",
    "PoisonBomb", "LightningBomb", "VoidBomb", "NebulaBomb", "DivineBomb"
}

local RadarNames = {
    "CrystalRadar", "RarityRadar", "BoulderRadar",
    "RuneRadar", "MeteorRadar", "ZenithRadar"
}


-- ============================================
-- 📱 MAIN GUI & SCREEN DESIGN
-- ============================================

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "UtilityGui"
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

-- Menu Toggle Button (Original Position & Size)
local MenuButton = Instance.new("TextButton")
MenuButton.Name = "MenuButton"
MenuButton.Parent = ScreenGui
MenuButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
MenuButton.Position = UDim2.new(0.02, 0, 0.02, 0)
MenuButton.Size = UDim2.new(0, 55, 0, 28)
MenuButton.Font = Enum.Font.SourceSansBold
MenuButton.Text = "MENU"
MenuButton.TextColor3 = Color3.fromRGB(255, 255, 255)
MenuButton.TextSize = 12

local MenuCorner = Instance.new("UICorner")
MenuCorner.CornerRadius = UDim.new(0, 6)
MenuCorner.Parent = MenuButton

-- Main Frame (Original Size, Top-Center Position)
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BackgroundTransparency = 0.1
MainFrame.AnchorPoint = Vector2.new(0.5, 0)
MainFrame.Position = UDim2.new(0.5, 0, 0, 40) -- Naka-pwesto na sa itaas (gitna horizontally)
MainFrame.Size = UDim2.new(0, 380, 0, 220) -- Original Size
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.ClipsDescendants = true
MainFrame.Visible = false -- Naka-hide by default

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 10)
FrameCorner.Parent = MainFrame

-- Neon Border Glow Effect
local MainStroke = Instance.new("UIStroke")
MainStroke.Parent = MainFrame
MainStroke.Color = Color3.fromRGB(0, 170, 255) -- Cyan Glow
MainStroke.Thickness = 2
MainStroke.Transparency = 0.2

-- Creator Title Header inside Main Frame
local CreatorTitle = Instance.new("TextLabel")
CreatorTitle.Name = "CreatorTitle"
CreatorTitle.Parent = MainFrame
CreatorTitle.BackgroundTransparency = 1
CreatorTitle.Position = UDim2.new(0, 0, 0, 10)
CreatorTitle.Size = UDim2.new(1, 0, 0, 25)
CreatorTitle.Font = Enum.Font.GothamBold
CreatorTitle.Text = "Creator Script by: Stuarth quider"
CreatorTitle.TextColor3 = Color3.fromRGB(255, 215, 0) -- Gold Text
CreatorTitle.TextSize = 13
CreatorTitle.TextTransparency = 0

-- Helper function for button creation
local function createButton(name, text, pos, size, textSize)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.Position = pos
    btn.Size = size
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = textSize or 13
    btn.TextTransparency = 0
    btn.BackgroundTransparency = 0

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    return btn
end

-- 2-Column Grid Layout (Original Sizes)
local HopButton    = createButton("HopButton", "HOP: OFF", UDim2.new(0, 15, 0, 45), UDim2.new(0, 170, 0, 45))
local RejoinButton = createButton("RejoinButton", "REJ: OFF", UDim2.new(0, 195, 0, 45), UDim2.new(0, 170, 0, 45))

local BuyButton    = createButton("BuyButton", "BUY: OFF", UDim2.new(0, 15, 0, 100), UDim2.new(0, 170, 0, 45))
local PickupButton = createButton("PickupButton", "PICK: OFF", UDim2.new(0, 195, 0, 100), UDim2.new(0, 170, 0, 45))

local DexButton    = createButton("DexButton", "DEX: OFF", UDim2.new(0, 15, 0, 155), UDim2.new(0, 170, 0, 45))
local IYButton     = createButton("IYButton", "INFI: OFF", UDim2.new(0, 195, 0, 155), UDim2.new(0, 170, 0, 45))

local TargetWidth = 380
local TargetHeight = 220


-- ============================================
-- 🔄 LOGIC & CONTROLS
-- ============================================

local autoHopEnabled = false
local autoBuyEnabled = false
local autoPickupEnabled = false
local dexLoaded = false
local iyLoaded = false
local rejoinTriggered = false
local promptConnection = nil
local isAnimating = false

-- Function para sa Smooth 2-Second Opening Animation kapag clinick ang MENU
MenuButton.MouseButton1Click:Connect(function()
    if isAnimating then return end
    
    if not MainFrame.Visible then
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Visible = true
        isAnimating = true
        
        CreatorTitle.TextTransparency = 1
        local buttons = {HopButton, RejoinButton, BuyButton, PickupButton, DexButton, IYButton}
        for _, btn in ipairs(buttons) do
            btn.TextTransparency = 1
            btn.BackgroundTransparency = 1
        end
        
        local openInfo = TweenInfo.new(2.0, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
        TweenService:Create(MainFrame, openInfo, {Size = UDim2.new(0, TargetWidth, 0, TargetHeight)}):Play()
        
        local fadeInInfo = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(CreatorTitle, fadeInInfo, {TextTransparency = 0}):Play()
        for _, btn in ipairs(buttons) do
            TweenService:Create(btn, fadeInInfo, {TextTransparency = 0, BackgroundTransparency = 0}):Play()
        end
        
        task.wait(2.0)
        isAnimating = false
    else
        MainFrame.Visible = false
    end
end)

-- Server Hop
local function serverHop()
    local success, response = pcall(function()
        local sortOrder = math.random(1, 2) == 1 and "Asc" or "Desc"
        return game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100")
    end)
    
    if success and response then
        local site = HttpService:JSONDecode(response)
        if site and site.data then
            for _, server in ipairs(site.data) do
                if server.id ~= JobId and server.playing < server.maxPlayers then
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                    break
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if autoHopEnabled then
            HopButton.Text = "HOPPING..."
            serverHop()
        end
        task.wait(3)
    end
end)

HopButton.MouseButton1Click:Connect(function()
    autoHopEnabled = not autoHopEnabled
    if autoHopEnabled then
        HopButton.Text = "HOP: ON"
        HopButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        serverHop()
    else
        HopButton.Text = "HOP: OFF"
        HopButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Rejoin Logic
RejoinButton.MouseButton1Click:Connect(function()
    if not rejoinTriggered then
        rejoinTriggered = true
        RejoinButton.Text = "REJ: ON"
        RejoinButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        task.wait(0.2)
        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(PlaceId, LocalPlayer)
        else
            TeleportService:TeleportToPlaceInstance(PlaceId, JobId, LocalPlayer)
        end
    end
end)

-- Throttled Auto-Buy
task.spawn(function()
    while true do
        if autoBuyEnabled then
            for _, bombName in ipairs(BombNames) do
                pcall(function() BombRemote:FireServer(bombName) end)
            end
            for _, radarName in ipairs(RadarNames) do
                pcall(function() RadarRemote:FireServer(radarName) end)
            end
        end
        task.wait(0.2)
    end
end)

BuyButton.MouseButton1Click:Connect(function()
    autoBuyEnabled = not autoBuyEnabled
    if autoBuyEnabled then
        BuyButton.Text = "BUY: ON"
        BuyButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        BuyButton.Text = "BUY: OFF"
        BuyButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Auto Pickup
PickupButton.MouseButton1Click:Connect(function()
    autoPickupEnabled = not autoPickupEnabled
    if autoPickupEnabled then
        PickupButton.Text = "PICK: ON"
        PickupButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        promptConnection = ProximityPromptService.PromptShown:Connect(function(prompt)
            if autoPickupEnabled and fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end)
    else
        PickupButton.Text = "PICK: OFF"
        PickupButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if promptConnection then
            promptConnection:Disconnect()
            promptConnection = nil
        end
    end
end)

-- Dex Explorer
DexButton.MouseButton1Click:Connect(function()
    if not dexLoaded then
        dexLoaded = true
        DexButton.Text = "DEX: ON"
        DexButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        loadstring(game:HttpGet("https://github.com/AZYsGithub/DexPlusPlus/releases/latest/download/out.lua"))()
    end
end)

-- Infinite Yield Script
IYButton.MouseButton1Click:Connect(function()
    if not iyLoaded then
        iyLoaded = true
        IYButton.Text = "INFI: ON"
        IYButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()
    end
end)
